{
  "name": "@eqman00003/dsh-office-com",
  "description": "Windows 本机真实 Office 自动化插件（DSH）：契约、任务级、故障注入、进程泄漏回归已覆盖；真实 Office 测试需在目标机器上执行",
  "version": "1.0.2",
  "type": "module",
  "main": "lib/index.mjs",
  "scripts": {
    "test": "node test/register.mjs",
    "test:e2e": "node test/smoke.mjs && node test/headless.mjs",
    "test:leak": "node test/leakcheck.mjs",
    "test:flagship": "node test/flagship.mjs",
    "test:tasks": "node test/tasks.mjs",
    "test:faults": "node test/faults.mjs",
    "test:all": "npm test && npm run test:e2e && npm run test:flagship && npm run test:tasks && npm run test:faults"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wly8691-jpg/dsh-office-com.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "office",
    "excel",
    "word",
    "com",
    "vba",
    "pivot-table"
  ],
  "license": "MIT"
}
